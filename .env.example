# Sin estas dos variables el demo usa los JSON de src/data.
# En Netlify: definirlas en Site settings → Environment variables.
CMS_URL=https://orbit-cms-backend.test
# Token de solo lectura del sitio (CMS → Administración → Sitios → Tokens de lectura,
# o el de monteOcre en ../orbit-cms-backend/.orbit/contract-tokens.json)
CMS_TOKEN=

# Solo desarrollo: secreto de POST /_refresh (el CMS lo llama al publicar).
# El build hook del sitio en el CMS debe ser http://host.containers.internal:4321/_refresh?secret=<este valor>
# (el CMS corre en un contenedor de lerd: para él «localhost» es el contenedor)
REFRESH_SECRET=
