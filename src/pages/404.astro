---
import "../styles/site.css";
import { fill } from "@jfreites/orbit-cms/site";
import SitePage from "@jfreites/orbit-cms/site/layouts/SitePage.astro";
import NotFound from "@jfreites/orbit-cms/site/components/NotFound.astro";
import { getNav, getSite } from "@jfreites/orbit-cms/site/content";

const site = await getSite();
const nav = await getNav(false);
const seo = { title: fill(site.ui.not_found.seo_title, { site: site.site_name }) };
---

<SitePage seo={seo} site={site} nav={nav} noindex>
	<NotFound site={site} />
</SitePage>
